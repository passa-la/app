{
  "expo": {
    "name": "passa l\u00e1?",
    "slug": "passa-la",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.passala.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#17150F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.passala.app",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "scheme": "passala",
    "plugins": [
      "expo-router",
      "expo-asset",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O passa l\u00e1? usa a sua localiza\u00e7\u00e3o pra mostrar onde voc\u00ea est\u00e1, a parada mais perto e o caminho a p\u00e9."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notify.png",
          "color": "#FFC21A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
